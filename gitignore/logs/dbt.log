[0m13:37:06.009428 [debug] [Thread-2 (]: On model.sport_data.int_deplacements_controles: /* {"app": "dbt", "dbt_version": "1.12.6", "profile_name": "sport_data", "target_name": "dev", "node_id": "model.sport_data.int_deplacements_controles"} */

  
  create view "warehouse"."main_intermediate"."int_deplacements_controles__dbt_tmp" as (
    -- Contrôle des déclarations de déplacement domicile-travail sportif (marche, vélo...)
-- statut : 'ok', 'incoherent' (distance > seuil) ou 'non_calcule' (adresse introuvable,
-- API indisponible). Les seuils sont dans seeds/regles_deplacement.csv.
with rh as (
    select * from "warehouse"."main_staging"."stg_rh"
),

regles as (
    select * from "warehouse"."main_seeds"."regles_deplacement"
),

distances as (
    select * from "warehouse"."main_intermediate"."int_distances_domicile"
)

select
    rh.id_salarie,
    rh.prenom,
    rh.nom,
    rh.adresse_domicile,
    rh.moyen_deplacement,
    distances.distance_km,
    regles.distance_max_km,
    case
        when distances.distance_km is null then 'non_calcule'
        when distances.distance_km > regles.distance_max_km then 'incoherent'
        else 'ok'
    end as statut
from rh
join regles using (moyen_deplacement)

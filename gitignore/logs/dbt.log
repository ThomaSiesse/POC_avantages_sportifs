  create view "warehouse"."main_staging"."stg_rh__dbt_tmp" as (
    select
    cast("ID salarié" as integer) as id_salarie,
    trim("Nom") as nom,
    trim("Prénom") as prenom,
    cast("Date de naissance" as date) as date_naissance,
    "BU" as bu,
    cast("Date d'embauche" as date) as date_embauche,
    cast("Salaire brut" as integer) as salaire_brut,
    "Type de contrat" as type_contrat,
    cast("Nombre de jours de CP" as integer) as nb_jours_cp,
    "Adresse du domicile" as adresse_domicile,
    "Moyen de déplacement" as moyen_deplacement
from read_xlsx('/data/donnees_rh.xlsx')
  );

[0m13:37:03.773399 [debug] [Thread-4 (]: SQL status: OK in 0.004 seconds
[0m13:37:03.774003 [debug] [Thread-1 (]: On model.sport_data.stg_activites: /* {"app": "dbt", "dbt_version": "1.12.6", "profile_name": "sport_data", "target_name": "dev", "node_id": "model.sport_data.stg_activites"} */

  
  create view "warehouse"."main_staging"."stg_activites__dbt_tmp" as (
    -- Une ligne par activité : dernière version connue de chaque id_activite
-- (le raw contient le snapshot Debezium, les créations et d'éventuels doublons)
with source as (
    select * from delta_scan('s3://raw/activites')
),

derniere_version as (
    select *
    from source
    qualify row_number() over (
        partition by id_activite
        order by source_ts_ms desc, ingested_at desc
    ) = 1
)

select
    id_activite,
    id_salarie,
    cast(date_debut as timestamptz) as date_debut,
    cast(date_fin as timestamptz) as date_fin,
    type_sport,
    distance_m,
    commentaire,
    op as derniere_operation,
    ingested_at
from derniere_version
  );


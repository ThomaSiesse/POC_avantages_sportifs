[0m13:23:37.719772 [debug] [Thread-1 (]: On model.sport_data.stg_activites: /* {"app": "dbt", "dbt_version": "1.12.6", "profile_name": "sport_data", "target_name": "dev", "node_id": "model.sport_data.stg_activites"} */

  
  create view "warehouse"."main_staging"."stg_activites__dbt_tmp" as (
    -- Une ligne par activité : dernière version connue de chaque id_activite
-- (le raw contient le snapshot Debezium, les créations et d'éventuels doublons)
with source as (
    select * from delta_scan('s3://raw/activites')
),

derniere_version as (
    select *
    from source
    qualify row_number() over (
        partition by id_activite
        order by source_ts_ms desc, ingested_at desc
    ) = 1
)

select
    id_activite,
    id_salarie,
    cast(date_debut as timestamptz) as date_debut,
    cast(date_fin as timestamptz) as date_fin,
    type_sport,
    distance_m,
    commentaire,
    op as derniere_operation,
    ingested_at
from derniere_version
  );

